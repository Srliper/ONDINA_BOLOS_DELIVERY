# URL pública do site (opcional). Usada no Open Graph, no link canônico e nos dados do Google.
VITE_SITE_URL=https://ondinabolos.com.br

# Webhook do n8n que recebe cada pedido (opcional). No n8n, libere este site em
# Webhook → Options → Allowed Origins (CORS), senão o navegador bloqueia o envio.
VITE_N8N_WEBHOOK_URL=https://n8n.ondinabolos.com/webhook/pedido-recebido

# Senha da área /admin (OBRIGATÓRIA para liberar o acesso). Fica só no servidor:
# configure no painel da Vercel (Settings → Environment Variables), nunca no código.
ADMIN_PASSWORD=
# Opcional: segredo que assina o cookie de sessão. Sem ele, é derivado da senha.
ADMIN_SESSION_SECRET=

# Lista de pedidos no painel /admin (opcional; só no servidor). Ver "Pedidos no painel" no README.
N8N_ORDERS_URL=
N8N_ORDERS_KEY=

# Banco do cardápio editável (Upstash Redis; a Vercel cria estas duas ao conectar o banco).
# Sem elas, no computador o cardápio fica em .data/catalog.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Pagamento pelo site (opcional; só no servidor). Sem o token, o checkout oferece só o WhatsApp.
# Mercado Pago → Suas integrações → Credenciais de produção → Access Token (APP_USR-…).
# Para testar sem cobrar, use o Access Token de teste (TEST-…).
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: "Assinatura secreta" das notificações (Webhooks) do Mercado Pago, para conferir a origem.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: endereço público do site usado na volta do pagamento (padrão: VITE_SITE_URL).
SITE_URL=

# Avisos para a equipe com o painel fechado (opcional): pedido novo pelo site, pagamento aprovado,
# mensagem de cliente e "avise-me" de bolo esgotado. O n8n pode repassar no WhatsApp da loja.
N8N_STORE_ALERT_URL=
# Aviso de bolo esgotado (opcional).
N8N_STOCK_ALERT_URL=

# Notificações push no celular da equipe, mesmo com o painel fechado (opcional; só no servidor).
# Gere o par com: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: contato do dono das chaves (mailto:… ou https://…). Padrão: o endereço do site.
VAPID_SUBJECT=
