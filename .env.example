# URL pública do site (opcional). Usada no Open Graph, no link canônico e nos dados do Google.
VITE_SITE_URL=https://ondinabolos.com.br

# Webhook do n8n que recebe cada pedido (opcional). No n8n, libere este site em
# Webhook → Options → Allowed Origins (CORS), senão o navegador bloqueia o envio.
VITE_N8N_WEBHOOK_URL=https://n8n.ondinabolos.com/webhook/pedido-recebido
